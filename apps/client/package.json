{
  "name": "demand-search-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev:h5": "node scripts/build.mjs h5 --watch",
    "build:h5": "node scripts/build.mjs h5",
    "build:weapp": "node scripts/build.mjs weapp",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src config tests",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/plugin-transform-class-properties": "7.27.1",
    "@playwright/test": "1.64.1",
    "@tarojs/plugin-framework-react": "file:tooling/taro-plugin-framework-react",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/vite-runner": "file:tooling/taro-vite-runner",
    "@types/node": "24.10.0",
    "@types/react": "18.3.31",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.14.0",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "@tarojs/service": "4.3.2",
    "globs": "file:tooling/globs"
  },
  "overrides": {
    "postcss": "$postcss",
    "adm-zip": "0.6.1",
    "serialize-javascript": "7.1.4",
    "lodash-es": "4.18.1",
    "http-cache-semantics": "4.3.0",
    "swiper": "12.1.4",
    "esbuild": "0.25.12",
    "minimatch@>=9": "11.0.4",
    "glob@>=10": "14.0.3",
    "globs": "$globs"
  }
}
